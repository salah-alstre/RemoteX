{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RemoteX",
  "version": "0.1.0",
  "identifier": "app.remotex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RemoteX",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://45.88.9.191:8443/updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "RemoteX Labs",
    "copyright": "© RemoteX Labs",
    "category": "Utility",
    "shortDescription": "Fast, secure remote desktop",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "en-US",
          "ar-SA"
        ]
      }
    },
    "resources": {
      "../../../THIRD-PARTY-LICENSES.txt": "THIRD-PARTY-LICENSES.txt",
      "../../../LICENSE": "LICENSE.txt"
    }
  }
}
