<?xml version="1.0" encoding="utf-8"?>
<!-- Installs, starts and removes the RemoteX elevated-control Windows service with the MSI.
     The service executable ships as a resource next to remotex.exe; `remotex-service.exe install`
     creates the service (automatic start, restart on failure, restricted access list). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="RemoteXServiceMarker" Guid="{6D0C5E1B-6C56-4E0A-9B39-8E6E2C1F5A11}">
        <RegistryValue Root="HKLM" Key="Software\RemoteX" Name="ServiceInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="RemoteXServiceInstall" Directory="INSTALLDIR" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[INSTALLDIR]remotex-service.exe&quot; install" />
    <CustomAction Id="RemoteXServiceRemove" Directory="INSTALLDIR" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[INSTALLDIR]remotex-service.exe&quot; uninstall" />

    <InstallExecuteSequence>
      <Custom Action="RemoteXServiceRemove" Before="RemoveFiles">REMOVE~="ALL"</Custom>
      <Custom Action="RemoteXServiceInstall" After="InstallFiles">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
