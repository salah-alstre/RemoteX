{
  "name": "remotex",
  "private": true,
  "version": "0.1.0",
  "description": "RemoteX remote desktop workspace",
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "build:windows": "node scripts/build-windows.mjs",
    "build:server": "node scripts/build-server.mjs",
    "test": "npm run test --workspace apps/desktop && cargo test --workspace",
    "lint": "npm run lint --workspace apps/desktop && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "npm run typecheck --workspace apps/desktop",
    "format": "cargo fmt --all"
  },
  "workspaces": ["apps/desktop"]
}
