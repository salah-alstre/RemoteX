# RemoteX server configuration. Copy to `.env` next to remotex-server.exe (install-server.ps1 does this for you).
# Never commit a real `.env`.

# Interface and the single public port (HTTPS + WebSocket signaling + relay + health + admin). TCP only.
SERVER_HOST=0.0.0.0
SERVER_PORT=8443

# The public address of this server (informational). Clients get their address from production.json at build time.
PUBLIC_SERVER_URL=wss://45.88.9.191:8443/ws

# SQLite database file (device registry, session metadata, auth attempts). Not exposed on any port.
DATABASE_PATH=data\remotex.db

# REQUIRED. >= 32 random characters. Pepper used when hashing device secrets. Rotating it invalidates every device.
SERVER_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# REQUIRED. >= 20 random characters. Bearer token for /admin/api/stats.
ADMIN_TOKEN=change-me-admin-token-20-chars-min

# TLS. Set both for production. With a domain use the CA-issued certificate (e.g. from win-acme / Let's Encrypt).
# For IP-only testing, `remotex-server.exe gen-cert --ip 45.88.9.191 --out certs` creates a self-signed pair
# whose SHA-256 fingerprint goes into the client build (apps/desktop/src-tauri/config/production.json).
TLS_CERT_PATH=certs\server.crt
TLS_KEY_PATH=certs\server.key

LOG_DIR=logs
MAX_SESSIONS=500
MAX_RELAY_MBPS_PER_SESSION=80
# Directory served at /updates (put latest.json and signed installers here).
UPDATES_DIR=updates

# Set to 1 ONLY behind a TLS-terminating reverse proxy. Without TLS_* the server otherwise refuses non-loopback binds.
# ALLOW_PLAIN_HTTP=0
